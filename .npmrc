# Auth for publishing to public npm. The value is expanded from the environment
# at run time and is NEVER stored here — run publish through the vault:
#
#   dd-env run -- npm publish
#
# A user-level ~/.npmrc token takes lower precedence than this file, which is
# what we want: the stale token there returns 401.
//registry.npmjs.org/:_authToken=${NPM_TOKEN}
